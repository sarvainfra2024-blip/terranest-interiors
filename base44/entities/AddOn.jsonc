{
  "name": "AddOn",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Add-on Name"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "price": {
      "type": "number",
      "title": "Price (\u20b9)"
    },
    "category": {
      "type": "string",
      "enum": [
        "Kitchen",
        "Storage",
        "Living",
        "Bedroom",
        "Ceiling & Lighting",
        "Smart Home",
        "Special Rooms",
        "Outdoor"
      ],
      "title": "Category"
    },
    "icon": {
      "type": "string",
      "title": "Icon Name (lucide)"
    },
    "image_url": {
      "type": "string",
      "title": "Image URL"
    },
    "is_active": {
      "type": "boolean",
      "title": "Active",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "title": "Sort Order",
      "default": 0
    }
  },
  "required": [
    "name",
    "price"
  ]
}