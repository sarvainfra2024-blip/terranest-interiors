{
  "name": "ProcessStep",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Step Title"
    },
    "desc": {
      "type": "string",
      "title": "Description"
    },
    "detail": {
      "type": "string",
      "title": "Detail Label (e.g. Free of charge)"
    },
    "icon": {
      "type": "string",
      "title": "Icon (lucide name)",
      "default": "Home"
    },
    "order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "desc"
  ]
}