{
  "name": "Office",
  "type": "object",
  "properties": {
    "city": {
      "type": "string",
      "title": "City / Location Name"
    },
    "address": {
      "type": "string",
      "title": "Full Address"
    },
    "phone": {
      "type": "string",
      "title": "Phone Number"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "hours": {
      "type": "string",
      "title": "Office Hours (optional)"
    },
    "map_url": {
      "type": "string",
      "title": "Google Maps Embed URL (optional)"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "city",
    "address"
  ]
}