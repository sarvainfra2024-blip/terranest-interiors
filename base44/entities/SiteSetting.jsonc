{
  "name": "SiteSetting",
  "type": "object",
  "properties": {
    "company_name": {
      "type": "string",
      "default": "Terranest Interiors"
    },
    "admin_header_name": {
      "type": "string",
      "title": "Admin Panel Header Name"
    },
    "logo_url": {
      "type": "string",
      "title": "Company Logo URL"
    },
    "tagline": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "whatsapp_number": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "hero_title": {
      "type": "string"
    },
    "hero_subtitle": {
      "type": "string"
    },
    "hero_image": {
      "type": "string"
    },
    "about_title": {
      "type": "string"
    },
    "about_description": {
      "type": "string"
    },
    "about_image": {
      "type": "string"
    },
    "story_label": {
      "type": "string",
      "title": "Our Story Label",
      "default": "Our Story"
    },
