      "type": "string",
      "title": "Our Story Paragraph 1"
    },
    "story_para2": {
      "type": "string",
      "title": "Our Story Paragraph 2"
    },
    "footer_text": {
      "type": "string"
    },
    "why_choose_label": {
      "type": "string",
      "title": "Why Terranest Label"
    },
    "why_choose_title": {
      "type": "string",
      "title": "Why Terranest Heading"
    },
    "process_label": {
      "type": "string",
      "title": "Process Page Label"
    },
    "process_title": {
      "type": "string",
      "title": "Process Page Heading"
    },
    "process_subtitle": {
      "type": "string",
      "title": "Process Page Subtitle"
    },
    "portfolio_label": {
      "type": "string",
      "title": "Our Work Label",
      "default": "Our Work"
    },
    "portfolio_title": {
      "type": "string",
      "title": "Our Work Heading",
      "default": "Spaces We've Transformed"
    },
    "portfolio_subtitle": {
      "type": "string",
      "title": "Our Work Subtitle",
      "default": "Each project is a unique story of vision meeting craftsmanship."
    },
    "welcome_onboard_subject": {
      "type": "string",
      "title": "Welcome Onboard Email Subject",
      "default": "Welcome Onboard! Your Interior Journey Begins"
    },
    "welcome_onboard_title": {
      "type": "string",
      "title": "Welcome Onboard Title",
      "default": "Welcome Onboard"
    },
    "welcome_onboard_message": {
      "type": "string",
      "title": "Welcome Onboard Message",
      "default": "We're thrilled to begin your interior design journey with you. This is your dedicated project portal where you can track every stage of your project \u2014 from initial measurement to final handover. If you have any questions, our team is always here to help."
    },
    "facebook_url": {
      "type": "string"
    },
    "instagram_url": {
      "type": "string"
    },
    "linkedin_url": {
      "type": "string"
    },
    "show_instant_estimate": {
      "type": "boolean",
      "title": "Show Instant Estimate on Pricing Page",
      "default": true
    },
    "stat_customers": {
      "type": "number",
      "default": 6000
    },
    "stat_customers_suffix": {
      "type": "string",
      "default": "+"
    },
    "stat_experience": {
      "type": "number",
      "default": 12
    },
    "stat_experience_suffix": {
      "type": "string",
      "default": "+"
    },
    "stat_designs": {
      "type": "number",
