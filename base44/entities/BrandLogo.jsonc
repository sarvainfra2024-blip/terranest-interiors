{
  "name": "BrandLogo",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Brand Name"
    },
    "logo_url": {
      "type": "string",
      "title": "Logo URL (SVG/PNG)"
    },
    "website_url": {
      "type": "string",
      "title": "Brand Website (optional)"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "logo_url"
  ]
}