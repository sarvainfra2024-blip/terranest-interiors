{
  "name": "ModuleType",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Module Type Name"
    },
    "default_carcass_material": {
      "type": "string",
      "title": "Default Carcass Material"
    },
    "default_shutter_material": {
      "type": "string",
      "title": "Default Shutter Material"
    },
    "order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "title": "Active"
    }
  },
  "required": [
